{
    "bindings": [
        {
            "type": "eventHubTrigger",
            "name": "eventHubMessages",
            "direction": "in",
            "eventHubName": "traffic-mirror",
            "connection": "EVENTHUB_CONNECTION_STRING",
            "cardinality": "many",
            "consumerGroup": "$Default"
        },
        {
            "type": "eventHub",
            "name": "outputEventHubMessages",
            "direction": "out",
            "eventHubName": "cdna-telemetry",
            "connection": "EVENTHUB_CONNECTION_STRING"
        }
    ]
}